---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogs = await getCollection("blogs");
const sortedBlogs = blogs.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Get all tags
const tags = Array.from(new Set(blogs.flatMap(b => b.data.tags || [])));
---

<BaseLayout title="AI Learnings Blogs" description="In-depth engineering blogs on LLM reasoning architectures, autonomous agents, modern RAG, and MCP protocols.">
  <div class="mx-auto max-w-5xl px-6 py-14 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-4 border-b border-slate-200 dark:border-slate-800 pb-8 mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 w-fit">
        <span>✨</span> AI Engineering Insights & Deep Dives
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl tracking-tight text-slate-900 dark:text-white">
        AI Learnings & Engineering Blogs
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed font-normal">
        Practical lessons, architectural blueprints, and deep research breakdowns on LLMs, agentic patterns, test-time compute, Model Context Protocol, and high-performance vector retrieval.
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          <span class="text-xs text-slate-500 dark:text-slate-400 flex items-center font-medium pr-2">Topics:</span>
          {tags.map((tag) => (
            <a 
              href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
              class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800/80 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white px-3 py-1 text-xs text-slate-600 dark:text-slate-300 transition-all font-mono shadow-sm"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedBlogs.map((blog) => (
        <a href={`/blogs/${blog.id.replace(/\.[^/.]+$/, "")}`} class="flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800/90 p-7 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/5 transition-all bg-white dark:bg-[#131B2A] group">
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="rounded-md border border-indigo-500/20 bg-indigo-500/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400 tracking-wider uppercase">
                {blog.data.category || "AI Engineering"}
              </span>
              <time datetime={blog.data.pubDate.toISOString()} class="text-xs text-slate-500 dark:text-slate-400">
                {blog.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <h2 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 leading-snug transition-colors">
              {blog.data.title}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
              {blog.data.description}
            </p>
          </div>
          <div class="mt-6 border-t border-slate-100 dark:border-slate-800/80 pt-4 flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400">By {blog.data.author}</span>
            <span class="font-bold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
              Read Blog &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

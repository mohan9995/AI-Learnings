---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('prompts');
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout entry={entry} collectionName="prompts" headings={headings}>
  <!-- Specific Prompt Section Render -->
  {entry.data.systemPrompt && (
    <div class="mb-6 border border-border-site rounded-apple overflow-hidden">
      <div class="bg-muted px-4 py-2 border-b border-border-site text-[10px] uppercase font-bold tracking-wider text-muted-text">
        System Instructions Template
      </div>
      <pre class="bg-card-site p-4 font-mono text-xs overflow-x-auto text-foreground border-0 !my-0 select-all whitespace-pre-wrap">{entry.data.systemPrompt}</pre>
    </div>
  )}

  {entry.data.userPrompt && (
    <div class="mb-6 border border-border-site rounded-apple overflow-hidden">
      <div class="bg-muted px-4 py-2 border-b border-border-site text-[10px] uppercase font-bold tracking-wider text-muted-text">
        User Template Prompt
      </div>
      <pre class="bg-card-site p-4 font-mono text-xs overflow-x-auto text-foreground border-0 !my-0 select-all whitespace-pre-wrap">{entry.data.userPrompt}</pre>
    </div>
  )}

  {entry.data.inputs && entry.data.inputs.length > 0 && (
    <div class="mb-6 border border-border-site rounded-apple overflow-hidden bg-card-site">
      <div class="bg-muted px-4 py-2 border-b border-border-site text-[10px] uppercase font-bold tracking-wider text-muted-text">
        Dynamic Merge Parameters
      </div>
      <div class="p-4 flex flex-col gap-3">
        {entry.data.inputs.map((inp: any) => (
          <div class="flex flex-col gap-0.5">
            <span class="font-mono text-xs font-semibold text-primary">{`{{${inp.name}}}`}</span>
            <span class="text-xs text-muted-text">{inp.desc}</span>
          </div>
        ))}
      </div>
    </div>
  )}
  
  <Content />
</ArticleLayout>

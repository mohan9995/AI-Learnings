---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE_NAME, SITE_DESCRIPTION, MAILCHIMP_ACTION_URL } from "@config";

// Fetch collections for homepage preview
const allBlogs = await getCollection("blogs");
const allTutorials = await getCollection("tutorials");
const allArchitecture = await getCollection("architecture");
const allPrompts = await getCollection("prompts");
const allReleases = await getCollection("releases");

const getSlug = (id: string) => id.replace(/\.[^/.]+$/, "");

// Sort and filter
const latestBlogs = allBlogs
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const featuredBlogs = allBlogs.filter(b => b.data.featured).slice(0, 4);
const featuredArchitecture = allArchitecture.filter(a => a.data.featured).slice(0, 3);
const featuredPrompts = allPrompts.filter(p => p.data.featured).slice(0, 3);

const latestReleases = allReleases
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Structured Learning Tracks
const learningTracks = [
  {
    title: "Track 1: LLM Reasoning & Foundations",
    desc: "Understand test-time compute, Monte Carlo Tree Search, chain-of-thought distillation, and how frontier models like DeepSeek-R1 and OpenAI o-series reason.",
    step: "01",
    links: [{ label: "Demystifying Reasoning Models", href: "/blogs/demystifying-reasoning-models" }]
  },
  {
    title: "Track 2: Production-Grade RAG Systems",
    desc: "Master hybrid search (BM25 + Dense Vectors), cross-encoder reranking, contextual chunking, and self-reflective retrieval pipelines.",
    step: "02",
    links: [{ label: "Building Modern RAG in 2026", href: "/blogs/building-production-rag-in-2026" }]
  },
  {
    title: "Track 3: Autonomous Agents & Tool Use (MCP)",
    desc: "Design multi-agent orchestrations, supervisor-worker topologies, tool calling loops, and integrate external services via the Model Context Protocol.",
    step: "03",
    links: [{ label: "Model Context Protocol Guide", href: "/blogs/model-context-protocol-guide" }]
  }
];

// Architecture Highlights
const architectureBlueprints = [
  {
    name: "Reflective Agent Loop",
    category: "Agent Architecture",
    tech: ["ReAct Loop", "Self-Correction", "Tool Calling"],
    link: "/architecture/multi-agent-orchestration-patterns"
  },
  {
    name: "Hybrid Vector + BM25 RAG",
    category: "Information Retrieval",
    tech: ["Reciprocal Rank Fusion", "Cross-Encoder", "Contextual Split"],
    link: "/tutorials/vector-database-hybrid-search"
  },
  {
    name: "Standardized Tool Gateway (MCP)",
    category: "Integration Protocol",
    tech: ["JSON-RPC", "Stateful Sessions", "Security Guardrails"],
    link: "/tutorials/local-mcp-server-development"
  }
];
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative mx-auto max-w-4xl px-6 pt-16 pb-20 sm:pt-24 sm:pb-28 text-center sm:px-8">
    <div class="flex flex-col items-center gap-6">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 tracking-wide shadow-sm">
        <span class="w-2 h-2 rounded-full bg-indigo-500 dark:bg-indigo-400 animate-pulse"></span>
        AI Engineering & Frontier LLM Insights
      </div>
      
      <!-- Main Title -->
      <h1 class="font-heading font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-text-site max-w-4xl leading-[1.12]">
        Master Generative & <span class="bg-gradient-to-r from-indigo-500 via-indigo-400 to-sky-400 bg-clip-text text-transparent">Agentic AI</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-muted-text max-w-2xl leading-relaxed font-normal">
        Deep-dive technical blogs, architectural blueprints, reasoning model internals, production RAG pipelines, and Model Context Protocol (MCP) implementations.
      </p>

      <!-- Prominent Search Centerpiece & CTAs -->
      <div class="w-full max-w-xl mx-auto mt-6 flex flex-col gap-4">
        <button 
          onclick="document.getElementById('search-dialog').showModal();"
          class="flex items-center justify-between w-full rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-[#131B2A] px-6 py-4 text-sm sm:text-base text-slate-500 dark:text-slate-400 hover:border-indigo-500 dark:hover:border-indigo-400 hover:text-slate-900 dark:hover:text-white shadow-xl shadow-indigo-500/5 hover:shadow-indigo-500/15 cursor-pointer transition-all duration-300 focus:outline-none group"
        >
          <div class="flex items-center gap-3.5">
            <svg class="h-5 w-5 text-indigo-500 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="text-sm sm:text-base font-normal">Search blogs, reasoning, agents, RAG, prompts...</span>
          </div>
          <kbd class="hidden sm:inline rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-xs font-mono tracking-widest text-slate-600 dark:text-slate-400">⌘K</kbd>
        </button>

        <!-- Quick Jump Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-1 text-xs">
          <span class="text-slate-500 dark:text-slate-400 font-medium mr-1">Trending Topics:</span>
          <a href="/tags/reasoning" class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-800/60 px-2.5 py-1 text-slate-600 dark:text-slate-300 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white transition-all font-mono">#Reasoning</a>
          <a href="/tags/agents" class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-800/60 px-2.5 py-1 text-slate-600 dark:text-slate-300 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white transition-all font-mono">#Agents</a>
          <a href="/tags/rag" class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-800/60 px-2.5 py-1 text-slate-600 dark:text-slate-300 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white transition-all font-mono">#RAG</a>
          <a href="/tags/mcp" class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-800/60 px-2.5 py-1 text-slate-600 dark:text-slate-300 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white transition-all font-mono">#MCP</a>
          <a href="/tags/fine-tuning" class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-800/60 px-2.5 py-1 text-slate-600 dark:text-slate-300 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white transition-all font-mono">#FineTuning</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Featured Blog Posts Section -->
  <section class="border-t border-slate-200 dark:border-slate-800/80 bg-slate-50/50 dark:bg-[#0E1524]/40 py-16">
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="rounded-md border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
            Featured Learnings
          </span>
          <h2 class="font-heading font-black text-2xl sm:text-3xl text-slate-900 dark:text-white tracking-tight mt-2">
            Essential AI Engineering Blogs
          </h2>
        </div>
        <a href="/blogs" class="text-xs sm:text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 group">
          Browse All Blogs <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestBlogs.map((blog) => (
          <a href={`/blogs/${getSlug(blog.id)}`} class="flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800/90 p-6 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/5 transition-all bg-white dark:bg-[#131B2A] group">
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <span class="rounded-md border border-indigo-500/20 bg-indigo-500/10 px-2 py-0.5 text-[11px] font-mono font-semibold text-indigo-600 dark:text-indigo-400 tracking-wider uppercase">
                  {blog.data.category || "AI Engineering"}
                </span>
                <time datetime={blog.data.pubDate.toISOString()} class="text-xs text-slate-500 dark:text-slate-400">
                  {blog.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 leading-snug transition-colors line-clamp-2">
                {blog.data.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
                {blog.data.description}
              </p>
            </div>
            
            <div class="mt-6 border-t border-slate-100 dark:border-slate-800/80 pt-4 flex items-center justify-between text-xs">
              <span class="text-slate-500 dark:text-slate-400 font-medium">By {blog.data.author}</span>
              <span class="font-bold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
                Read Article &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Structured Learning Tracks Section -->
  <section class="py-16">
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="rounded-md border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
          Roadmaps
        </span>
        <h2 class="font-heading font-black text-2xl sm:text-4xl text-slate-900 dark:text-white tracking-tight mt-2">
          Structured AI Learning Tracks
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2 font-normal">
          Follow systematic engineering paths designed to take you from foundational understanding to shipping autonomous agents in production.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {learningTracks.map((track) => (
          <div class="flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800/90 p-7 bg-white dark:bg-[#131B2A] relative overflow-hidden group hover:border-indigo-500/40 transition-all">
            <span class="absolute -right-4 -bottom-6 font-heading font-black text-8xl text-slate-100 dark:text-slate-800/30 select-none pointer-events-none group-hover:text-indigo-500/10 transition-colors">
              {track.step}
            </span>
            <div class="flex flex-col gap-3 relative z-10">
              <span class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">
                STEP {track.step}
              </span>
              <h3 class="font-heading font-bold text-lg text-slate-900 dark:text-white leading-snug">
                {track.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                {track.desc}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 relative z-10">
              {track.links.map((link) => (
                <a href={link.href} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 group">
                  {link.label} <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Architecture & System Blueprints -->
  <section class="border-t border-slate-200 dark:border-slate-800/80 bg-slate-50/50 dark:bg-[#0E1524]/40 py-16">
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="rounded-md border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
            Architecture
          </span>
          <h2 class="font-heading font-black text-2xl sm:text-3xl text-slate-900 dark:text-white tracking-tight mt-2">
            System & Model Architecture Blueprints
          </h2>
        </div>
        <a href="/architecture" class="text-xs sm:text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 group">
          View All Blueprints <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {architectureBlueprints.map((item) => (
          <a href={item.link} class="flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800/90 p-6 bg-white dark:bg-[#131B2A] hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/5 transition-all group">
            <div class="flex flex-col gap-3">
              <span class="text-[10px] font-mono uppercase font-bold text-slate-400 dark:text-slate-500 tracking-wider">
                {item.category}
              </span>
              <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug">
                {item.name}
              </h3>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {item.tech.map((t) => (
                  <span class="rounded bg-slate-100 dark:bg-slate-800/80 px-2 py-0.5 text-[10px] font-mono text-slate-600 dark:text-slate-400">
                    {t}
                  </span>
                ))}
              </div>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-end text-xs">
              <span class="font-bold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
                Explore Blueprint &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Frontier Model Releases -->
  {latestReleases.length > 0 && (
    <section class="py-16">
      <div class="mx-auto max-w-6xl px-6 sm:px-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="rounded-md border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
              Landscape
            </span>
            <h2 class="font-heading font-black text-2xl sm:text-3xl text-slate-900 dark:text-white tracking-tight mt-2">
              Frontier Model Releases & Benchmarks
            </h2>
          </div>
          <a href="/releases" class="text-xs sm:text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 group">
            All Releases <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestReleases.map((rel) => (
            <a href={`/releases/${getSlug(rel.id)}`} class="flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800/90 p-6 bg-white dark:bg-[#131B2A] hover:border-indigo-500/50 transition-all group">
              <div class="flex flex-col gap-2.5">
                <div class="flex items-center justify-between">
                  <span class="rounded bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 px-2 py-0.5 text-[10px] font-mono font-bold uppercase">
                    v{rel.data.version} ({rel.data.type})
                  </span>
                  <time datetime={rel.data.pubDate.toISOString()} class="text-xs text-slate-400">
                    {rel.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                </div>
                <h3 class="font-heading font-bold text-base text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {rel.data.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                  {rel.data.description}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-xs font-bold text-indigo-600 dark:text-indigo-400 flex items-center justify-end">
                Read Breakdown &rarr;
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter Section -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-[#0E1524]/60 py-16">
    <div class="mx-auto max-w-3xl px-6 text-center sm:px-8">
      <div class="flex flex-col items-center gap-4">
        <div class="h-12 w-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="font-heading font-black text-2xl sm:text-4xl text-slate-900 dark:text-white tracking-tight">
          Stay on the Frontier of AI Engineering
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-lg leading-relaxed">
          Join thousands of developers and AI researchers receiving our weekly breakdown on reasoning models, agentic workflows, and production RAG.
        </p>

        <form 
          action={MAILCHIMP_ACTION_URL} 
          method="POST" 
          target="_blank" 
          class="flex flex-col sm:flex-row gap-2.5 w-full max-w-md mt-2"
          novalidate
        >
          <input 
            type="email" 
            name="EMAIL" 
            placeholder="Enter your email" 
            required 
            class="flex-1 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-[#131B2A] px-4 py-2.5 text-xs sm:text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm"
          />
          <button 
            type="submit" 
            class="rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs sm:text-sm px-5 py-2.5 shadow-md shadow-indigo-600/20 transition-all cursor-pointer whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

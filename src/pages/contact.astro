---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FOOTER_LINKS } from "@config";
---

<BaseLayout title="Contact AI Learnings" description="Get in touch with the AI Learnings contributor team for feedback, questions, or content submissions.">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      
      <!-- Contact Info Card (Col-span 5) -->
      <div class="md:col-span-5 flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-bold text-primary uppercase tracking-wider">Get in Touch</span>
          <h1 class="font-display font-extrabold text-3xl text-foreground">Contact Us</h1>
          <p class="text-xs text-muted-text leading-relaxed">
            Have questions about an article? Found an issue with code snippets or benchmarks? Want to contribute an AI engineering post? Reach out to our editorial team.
          </p>
        </div>

        <div class="flex flex-col gap-4 border-t border-border-site pt-6">
          <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-primary mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-foreground">Editorial Email</span>
              <a href="mailto:editor@ai-learnings.dev" class="text-xs text-primary hover:underline">editor@ai-learnings.dev</a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-primary mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-foreground">GitHub Discussions</span>
              <a href="https://github.com/mohan9995" class="text-xs text-primary hover:underline">mohan9995/ai-learnings</a>
            </div>
          </div>
        </div>

        <!-- Social Handles -->
        <div class="flex flex-col gap-2 border-t border-border-site pt-6">
          <span class="text-xs font-semibold text-foreground">Follow Us:</span>
          <div class="flex items-center gap-3">
            <a href={FOOTER_LINKS.socials.github} target="_blank" rel="noopener noreferrer" class="rounded-full border border-border-site p-2 text-muted-text hover:text-primary transition-all">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd"/></svg>
            </a>
            <a href={FOOTER_LINKS.socials.twitter} target="_blank" rel="noopener noreferrer" class="rounded-full border border-border-site p-2 text-muted-text hover:text-primary transition-all">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form Container (Col-span 7) -->
      <div class="md:col-span-7 bg-card-site border border-border-site rounded-apple p-6 sm:p-8">
        <form id="contact-form" class="flex flex-col gap-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="contact-name" class="text-xs font-semibold text-foreground">Your Name</label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="Jane Doe" 
                class="rounded-lg border border-border-site bg-bg-site px-3 py-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="contact-email" class="text-xs font-semibold text-foreground">Your Email</label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="jane@company.com" 
                class="rounded-lg border border-border-site bg-bg-site px-3 py-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="contact-subject" class="text-xs font-semibold text-foreground">Topic / Category</label>
            <select 
              id="contact-subject" 
              name="subject" 
              class="rounded-lg border border-border-site bg-bg-site px-3 py-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary"
            >
              <option value="content_submission">Article / Blog Submission</option>
              <option value="technical_feedback">Technical Feedback / Bug Report</option>
              <option value="collaboration">Collaboration / Research Sharing</option>
              <option value="other">Other Inquiry</option>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="contact-message" class="text-xs font-semibold text-foreground">Message</label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="5" 
              required 
              placeholder="Tell us what you'd like to share or suggest..." 
              class="rounded-lg border border-border-site bg-bg-site px-3 py-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary resize-y"
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="contact-submit-btn" 
            class="rounded-lg bg-primary hover:bg-primary-dark text-white font-bold text-xs py-2.5 px-4 transition-all cursor-pointer shadow-sm self-start mt-2"
          >
            Send Message
          </button>
          
          <div id="contact-status-msg" class="hidden text-xs mt-2 font-medium"></div>
        </form>

        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement | null;
          const statusMsg = document.getElementById('contact-status-msg');
          const submitBtn = document.getElementById('contact-submit-btn');

          if (form && statusMsg && submitBtn) {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              submitBtn.textContent = 'Message Received!';
              submitBtn.classList.add('opacity-80');
              statusMsg.textContent = 'Thank you! Your feedback has been recorded.';
              statusMsg.className = 'text-xs mt-2 font-medium text-emerald-600 dark:text-emerald-400 block';
              form.reset();
              setTimeout(() => {
                submitBtn.textContent = 'Send Message';
                submitBtn.classList.remove('opacity-80');
              }, 4000);
            });
          }
        </script>
      </div>

    </div>
  </div>
</BaseLayout>

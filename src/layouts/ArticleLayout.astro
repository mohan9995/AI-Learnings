---
import BaseLayout from "./BaseLayout.astro";
import { SITE_NAME, SITE_URL, GISCUS_CONFIG } from "@config";
import { getCollection } from "astro:content";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: any; // Astro collection entry
  collectionName: "blogs" | "tutorials" | "prompts" | "architecture" | "releases" | "interview";
  headings: Heading[];
}

const { entry, collectionName, headings } = Astro.props;
const {
  title,
  description,
  author,
  pubDate,
  updatedDate,
  tags = [],
  faqs = [],
  related = [],
  parent,
  previous,
  next,
  series,
} = entry.data;

// Dynamic Reading Time Calculation
const wordsPerMinute = 225;
const wordCount = entry.body ? entry.body.split(/\s+/g).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

// Fetch all elements in same collection for sibling navigation
const getSlug = (id: string) => id.replace(/\.[^/.]+$/, "");

const allEntries = await getCollection(collectionName);
const sortedEntries = allEntries.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const currentIndex = sortedEntries.findIndex(item => getSlug(item.id) === getSlug(entry.id));

// Parent article lookup (in same collection or matching slug)
const parentEntry = parent ? (allEntries.find(item => getSlug(item.id) === parent) || null) : null;

// Sibling Navigation (Previous/Next) - respects explicit sequencing or falls back to date order
let prevEntry = null;
if (previous) {
  if (previous !== 'none') {
    prevEntry = allEntries.find(item => getSlug(item.id) === previous) || null;
  }
} else {
  prevEntry = currentIndex < sortedEntries.length - 1 ? sortedEntries[currentIndex + 1] : null;
}

let nextEntry = null;
if (next) {
  if (next !== 'none') {
    nextEntry = allEntries.find(item => getSlug(item.id) === next) || null;
  }
} else {
  nextEntry = currentIndex > 0 ? sortedEntries[currentIndex - 1] : null;
}

// Related Articles (Based on tag overlap)
const currentTags = tags;
const relatedArticles = sortedEntries
  .filter(item => getSlug(item.id) !== getSlug(entry.id))
  .map(item => {
    const commonTags = (item.data.tags || []).filter((t: string) => currentTags.includes(t)).length;
    return { item, commonTags };
  })
  .filter(x => x.commonTags > 0)
  .sort((a, b) => b.commonTags - a.commonTags)
  .slice(0, 3)
  .map(x => x.item);

// SEO Schemas
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_NAME,
    "logo": {
      "@type": "ImageObject",
      "url": `${SITE_URL}/favicon.ico`
    }
  }
};

const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": SITE_URL
  },
  {
    "@type": "ListItem",
    "position": 2,
    "name": collectionName.charAt(0).toUpperCase() + collectionName.slice(1),
    "item": `${SITE_URL}/${collectionName}`
  }
];

if (parentEntry) {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": breadcrumbItems.length + 1,
    "name": parentEntry.data.title,
    "item": `${SITE_URL}/${collectionName}/${getSlug(parentEntry.id)}`
  });
}

breadcrumbItems.push({
  "@type": "ListItem",
  "position": breadcrumbItems.length + 1,
  "name": title,
  "item": `${SITE_URL}/${collectionName}/${getSlug(entry.id)}`
});

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

const faqJsonLd = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const schemas = [articleJsonLd, breadcrumbJsonLd];
if (faqJsonLd) schemas.push(faqJsonLd);
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={schemas}>
  <!-- Main Grid Layout -->
  <div class="mx-auto max-w-6xl px-6 py-10 sm:px-8 lg:px-12">
    
    <!-- Breadcrumbs Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8 overflow-x-auto whitespace-nowrap scrollbar-none py-1">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <a href={`/${collectionName}`} class="capitalize hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{collectionName}</a>
      {parentEntry && (
        <>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a href={`/${collectionName}/${getSlug(parentEntry.id)}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors truncate max-w-xs">{parentEntry.data.title}</a>
        </>
      )}
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium truncate max-w-xs">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Side Context Navigation Menu -->
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-24 max-h-[calc(100vh-120px)] overflow-y-auto pr-4 flex flex-col gap-6 scrollbar-thin">
          <div class="flex flex-col gap-3">
            <h4 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">More in {collectionName}</h4>
            <ul class="flex flex-col gap-1.5 border-l border-slate-200 dark:border-slate-800 pl-3">
              {sortedEntries.slice(0, 8).map((item) => (
                <li>
                  <a 
                    href={`/${collectionName}/${getSlug(item.id)}`} 
                    class={`text-xs block py-1.5 transition-all leading-relaxed hover:text-indigo-600 dark:hover:text-indigo-400 ${getSlug(item.id) === getSlug(entry.id) ? 'text-indigo-600 dark:text-indigo-400 font-bold -ml-[13px] pl-3 border-l-2 border-indigo-600 dark:border-indigo-400' : 'text-slate-600 dark:text-slate-400'}`}
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>

      <!-- Center Article Content Column -->
      <article class="col-span-1 lg:col-span-6 flex flex-col">
        <header class="flex flex-col gap-4 border-b border-slate-200 dark:border-slate-800 pb-8 mb-8">
          
          {(parentEntry || series) && (
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                {series && <span class="font-semibold">{series}</span>}
                {series && parentEntry && <span>·</span>}
                {parentEntry && (
                  <span>
                    Part of{' '}
                    <a href={`/${collectionName}/${getSlug(parentEntry.id)}`} class="underline font-semibold hover:text-indigo-900 dark:hover:text-indigo-100">
                      {parentEntry.data.title}
                    </a>
                  </span>
                )}
              </span>
            </div>
          )}
          
          <!-- Meta stats -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-slate-500 dark:text-slate-400">
            <span>By <strong class="text-slate-800 dark:text-slate-200 font-semibold">{author}</strong></span>
            <span class="h-1 w-1 rounded-full bg-slate-300 dark:bg-slate-700"></span>
            <time datetime={pubDate.toISOString()}>
              {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {updatedDate && (
              <>
                <span class="h-1 w-1 rounded-full bg-slate-300 dark:bg-slate-700"></span>
                <span>Updated: {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </>
            )}
            <span class="h-1 w-1 rounded-full bg-slate-300 dark:bg-slate-700"></span>
            <span>{readingTime} min read</span>
          </div>

          <h1 class="font-heading font-extrabold text-3xl sm:text-5xl tracking-tight text-slate-900 dark:text-white leading-[1.18]">
            {title}
          </h1>

          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
            {description}
          </p>

          <!-- Tags list -->
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-2">
              {tags.map((tag: string) => (
                <a 
                  href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                  class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100/80 dark:bg-slate-800/80 px-2.5 py-1 text-xs text-slate-600 dark:text-slate-300 hover:border-indigo-500/50 hover:text-indigo-600 dark:hover:text-white transition-all font-mono"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <!-- Markdown MDX Entry Body -->
        <div class="prose">
          <slot />
        </div>

        <!-- Dynamic Client-Side Copy Script and Mermaid Draw -->
        <script>
          // Injected copy code handler
          document.addEventListener('DOMContentLoaded', () => {
            const copyButtons = document.querySelectorAll('.copy-code-btn');
            copyButtons.forEach(btn => {
              btn.addEventListener('click', async () => {
                const container = btn.closest('.code-block-container');
                const code = container?.querySelector('pre')?.textContent || '';
                
                try {
                  await navigator.clipboard.writeText(code);
                  const btnText = btn.querySelector('.copy-btn-text');
                  if (btnText) {
                    const original = btnText.textContent;
                    btnText.textContent = 'Copied!';
                    btn.classList.add('bg-indigo-600', 'text-white');
                    setTimeout(() => {
                      btnText.textContent = original;
                      btn.classList.remove('bg-indigo-600', 'text-white');
                    }, 2000);
                  }
                } catch (err) {
                  console.error('Failed to copy text: ', err);
                }
              });
            });
          });
        </script>

        <!-- Dynamic Lazy-Load Mermaid Script -->
        {entry.body && entry.body.includes('```mermaid') && (
          <script>
            document.addEventListener('DOMContentLoaded', async () => {
              const mermaids = document.querySelectorAll('.mermaid');
              if (mermaids.length > 0) {
                try {
                  const { default: mermaid } = await import('mermaid');
                  mermaid.initialize({
                    startOnLoad: false,
                    theme: 'dark',
                    securityLevel: 'loose',
                  });
                  
                  // Render each diagram
                  mermaids.forEach(async (el, index) => {
                    const code = el.textContent || '';
                    el.innerHTML = '';
                    const id = `mermaid-${index}`;
                    const { svg } = await mermaid.render(id, code);
                    el.innerHTML = svg;
                  });
                } catch (err) {
                  console.error('Mermaid render error:', err);
                }
              }
            });
          </script>
        )}

        <!-- Share Buttons -->
        <div class="flex items-center gap-3 border-t border-b border-slate-200 dark:border-slate-800 py-4 my-8">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Share:</span>
          
          <!-- X / Twitter -->
          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800/80 p-2 text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-white transition-all"
            aria-label="Share on X"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>

          <!-- LinkedIn -->
          <a 
            href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(title)}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800/80 p-2 text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-white transition-all"
            aria-label="Share on LinkedIn"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>

          <!-- Copy Link -->
          <button 
            id="share-copy-link-btn" 
            class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800/80 p-2 text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-white transition-all cursor-pointer focus:outline-none"
            aria-label="Copy Link"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
          </button>
        </div>

        <script>
          const copyShare = document.getElementById('share-copy-link-btn');
          copyShare?.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(window.location.href);
              const original = copyShare.innerHTML;
              copyShare.innerHTML = `<span class="text-[11px] font-bold text-indigo-500 px-1">Copied!</span>`;
              setTimeout(() => {
                copyShare.innerHTML = original;
              }, 2000);
            } catch (err) {
              console.error(err);
            }
          });
        </script>

        <!-- FAQs Accordion -->
        {faqs.length > 0 && (
          <section class="mb-10 flex flex-col gap-4">
            <h2 class="font-heading font-extrabold text-xl text-slate-900 dark:text-white">Frequently Asked Questions</h2>
            <div class="flex flex-col border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden bg-slate-50/60 dark:bg-[#131B2A]">
              {faqs.map((faq: any, idx: number) => (
                <details class="group border-b last:border-b-0 border-slate-200 dark:border-slate-800/80 p-4 focus:outline-none">
                  <summary class="flex justify-between items-center font-bold text-sm text-slate-900 dark:text-white cursor-pointer list-none focus:outline-none">
                    <span>{faq.question}</span>
                    <span class="text-slate-400 transition-transform group-open:rotate-180">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </summary>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-3 pl-1 leading-relaxed">
                    {faq.answer}
                  </p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Sibling Navigation (Previous/Next) -->
        <nav class="flex justify-between items-center gap-4 py-6 border-t border-slate-200 dark:border-slate-800 mb-12">
          {prevEntry ? (
            <a href={`/${collectionName}/${getSlug(prevEntry.id)}`} class="flex flex-col gap-1 max-w-[45%] text-left group">
              <span class="text-xs uppercase font-bold text-slate-400 tracking-wider group-hover:text-indigo-600 dark:group-hover:text-indigo-400">← Previous</span>
              <span class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 line-clamp-1">{prevEntry.data.title}</span>
            </a>
          ) : (
            <div />
          )}
          {nextEntry ? (
            <a href={`/${collectionName}/${getSlug(nextEntry.id)}`} class="flex flex-col gap-1 max-w-[45%] text-right group">
              <span class="text-xs uppercase font-bold text-slate-400 tracking-wider group-hover:text-indigo-600 dark:group-hover:text-indigo-400">Next →</span>
              <span class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 line-clamp-1">{nextEntry.data.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <section class="mb-12">
            <h3 class="font-heading font-bold text-xs tracking-wider uppercase text-slate-400 dark:text-slate-500 mb-4">Related Articles</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {relatedArticles.map((item) => (
                <a href={`/${collectionName}/${getSlug(item.id)}`} class="flex flex-col gap-2 rounded-xl border border-slate-200 dark:border-slate-800/90 p-4 hover:border-indigo-500/50 transition-all bg-white dark:bg-[#131B2A] group">
                  <span class="rounded border border-indigo-500/20 bg-indigo-500/10 w-fit px-2 py-0.5 text-[10px] font-mono font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
                    {collectionName}
                  </span>
                  <h4 class="font-heading font-bold text-xs text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 line-clamp-2 leading-snug">{item.data.title}</h4>
                  <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">{item.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Comments Section (Giscus) -->
        <section class="border-t border-slate-200 dark:border-slate-800 pt-8 mb-12">
          <h3 class="font-heading font-bold text-lg text-slate-900 dark:text-white mb-4">Comments</h3>
          <div class="giscus"></div>
          
          <script 
            is:inline
            src="https://giscus.app/client.js"
            data-repo={GISCUS_CONFIG.repo}
            data-repo-id={GISCUS_CONFIG.repoId}
            data-category={GISCUS_CONFIG.category}
            data-category-id={GISCUS_CONFIG.categoryId}
            data-mapping={GISCUS_CONFIG.mapping}
            data-strict={GISCUS_CONFIG.strict}
            data-reactions-enabled={GISCUS_CONFIG.reactionsEnabled}
            data-emit-metadata={GISCUS_CONFIG.emitMetadata}
            data-input-position={GISCUS_CONFIG.inputPosition}
            data-theme={GISCUS_CONFIG.theme}
            data-lang={GISCUS_CONFIG.lang}
            data-loading={GISCUS_CONFIG.loading}
            crossorigin="anonymous"
            async
          ></script>
        </section>
      </article>

      <!-- Right Sidebar (Table of Contents) -->
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-24 pr-4 flex flex-col gap-6">
          {headings.length > 0 && (
            <div class="flex flex-col gap-3">
              <h4 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Table of Contents</h4>
              <nav class="flex flex-col gap-1.5 border-l border-slate-200 dark:border-slate-800 pl-3">
                {headings.filter(h => h.depth <= 3).map((h) => (
                  <a 
                    href={`#${h.slug}`}
                    class={`text-xs block py-1 text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all leading-snug ${h.depth === 3 ? 'pl-3 text-slate-500 dark:text-slate-500' : 'font-medium'}`}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </div>
          )}
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
